
pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t codepipeline .'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker stop codepipeline || true
                    docker rm codepipeline || true
                    docker run -d --name codepipeline -p 80:80 codepipeline
                '''
            }
        }
    }
}
